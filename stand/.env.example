# Template for stand/.env. run.sh copies it and replaces every CHANGE_ME with a
# random value; the real stand/.env is ignored by git. Names do not overlap with
# the OpenMetadata variables of docker-compose.yml, which keep the release defaults.

# Source PostgreSQL (orders): superuser for the init scripts, read-only catalog role.
SOURCE_PG_ADMIN_USER=picking_admin
SOURCE_PG_ADMIN_PASSWORD=CHANGE_ME
PICKING_PG_USER=catalog_reader
PICKING_PG_PASSWORD=CHANGE_ME
SOURCE_PG_PORT=15432

# Source ClickHouse (marketing): the single user created by the image entrypoint;
# it loads the fixtures, and the catalog reads with it.
MARKETING_CH_USER=marketing_user
MARKETING_CH_PASSWORD=CHANGE_ME
SOURCE_CH_PORT=18123

# Default administrator of a fresh OpenMetadata with basic authentication
# (docs v2.0.x quick-start/local-docker-deployment). Local stand only.
OM_ADMIN_EMAIL=admin@open-metadata.org
OM_ADMIN_PASSWORD=admin
